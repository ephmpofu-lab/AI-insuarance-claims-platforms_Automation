      ],
      "id": "13ad4972-4f28-4e4b-a6fa-068fe304c792",
      "name": "Explode_Binary_Files"
    },
    {
      "parameters": {
        "jsCode": "return items.map((item, index) => {\n\n  const original =\n    $('Explode_Binary_Files').all()[index].json;\n\n  return {\n    json: {\n\n      internal_claim_id:\n        original.internal_claim_id,\n\n      claim_number:\n        original.claim_number,\n\n      source_field:\n        original.source_field,\n\n      file_name:\n        original.file_name,\n\n      mime_type:\n        original.mime_type,\n\n      file_extension:\n        original.file_extension,\n\n      file_size:\n        original.file_size,\n\n      storage_key:\n        item.json.Key,\n\n      storage_id:\n        item.json.Id,\n\n      upload_status:\n        'UPLOADED'\n    }\n  };\n});"
      },
